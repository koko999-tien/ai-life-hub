# ==========================================
# AI Life Hub - Environment Variables
# ==========================================

# 1. AI Workspace Server-Side Providers (Configure AT LEAST ONE key below to enable live execution)
# NEVER prefix these keys with NEXT_PUBLIC_ — they must remain strictly server-only.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# 2. Supabase (Optional: app transparently falls back to LocalStorage mode if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://ai-life-hub-omega.vercel.app
